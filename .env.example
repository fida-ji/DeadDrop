# DeadDrop deployment environment (GenLayer Bradbury testnet only).
# Copy to .env and fill in. NEVER commit .env or share the private key.

# Private key of the funded deployer account on Bradbury.
# Fund it via the faucet: https://testnet-faucet.genlayer.foundation
# Format: 0x-prefixed 64-hex-char string. Read via process.env only.
ACCOUNT_PRIVATE_KEY=

# Optional: address that receives the protocol settlement fee.
# Leave blank to use the deployer address.
FEE_RECIPIENT=

# Optional: protocol fee in basis points taken from the payout on a successful
# settlement (100 = 1%). Leave blank to use the contract default (100).
FEE_BPS=
