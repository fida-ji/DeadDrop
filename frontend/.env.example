# Frontend configuration (optional). The deployed contract address is baked in
# as a fallback, so the app works with no configuration. Set this only to point
# the app at a different DeadDrop deployment.
#
# On Netlify, set VITE_CONTRACT_ADDRESS as a Site environment variable. Do not
# put secrets here; this file ships in the repo.
VITE_CONTRACT_ADDRESS=

# Optional: RPC endpoint override. By default the app calls the same-origin
# /api/rpc path (proxied to Bradbury by Netlify, or by Vite in dev). Hosting
# that cannot proxy API paths (e.g. Firebase Hosting) should build with:
#   VITE_RPC_ENDPOINT=https://rpc-bradbury.genlayer.com
VITE_RPC_ENDPOINT=
